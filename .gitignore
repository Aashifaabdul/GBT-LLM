# Raw/large regenerable data
*.yuv
*.7z
**/frames/*.png
**/blocks/
**/context/
**/block_overlay/
**/reconstructed/
**/original_crop/
**/reconstructed_video.mp4
**/original_video.mp4

# Checkpoints and results (regenerable via training.py / run_dataset_pipeline.py)
checkpoints/*.pt
results/

# Stray interrupted-write temp files (observed pattern from prior sandbox runs,
# e.g. ".frame0495_blocks_8x8.npy.FiW3i9", ".frame0537.png.lKmA3l") -- always
# dotfiles, never something we want tracked
.frame*

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Editors/OS
.DS_Store
Thumbs.db

# Keep small tracked artifacts explicitly (negation patterns, evaluated last)
!figures/.gitkeep
